 2
(1 row)

-- The first number with at least 200 digits.
EXPLAIN (ANALYZE, VERBOSE, COSTS OFF, TIMING OFF, SUMMARY OFF, BUFFERS OFF) SELECT line FROM fib WHERE length(line) >= 200 LIMIT 1;
                           QUERY PLAN                           
----------------------------------------------------------------
 Gather (actual rows=1 loops=1)
   Output: line
   Workers Planned: 1
   Workers Launched: 1
   Single Copy: true
   ->  Limit (actual rows=1 loops=1)
         Output: line
         Worker 0:  actual rows=1 loops=1
         ->  Foreign Scan on public.fib (actual rows=1 loops=1)
               Output: line
               Filter: (length(fib.line) >= 200)
