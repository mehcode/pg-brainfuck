             [>+<-[>+<-[>+<-[>[-]>+>+<<<-[>+<-]]]]]]]]]]]+>>>
     ]<<<
 ]
 
               Steps: 0
               Worker 0:  actual rows=4 loops=1
(20 rows)

SELECT line FROM fib LIMIT 1 OFFSET 3;
 line 
