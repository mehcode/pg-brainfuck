CREATE SERVER fdw_fib FOREIGN DATA WRAPPER brainfuck_fdw;
-- Prints the Fibonacci numbers from 0, one per line, forever.
-- https://www.hevanet.com/cristofd/brainfuck/fib.b
CREATE FOREIGN TABLE fib (line text) SERVER fdw_fib OPTIONS (program $$
>++++++++++>+>+[
    [+++++[>++++++++<-]>.<++++++[>--------<-]+<<<]>.>>[
        [-]<[>+<-]>>[<<+>+>-]<[>+<-[>+<-[>+<-[>+<-[>+<-[>+<-
            [>+<-[>+<-[>+<-[>[-]>+>+<<<-[>+<-]]]]]]]]]]]+>>>
    ]<<<
]
$$);
-- The 4th number.
EXPLAIN (ANALYZE, VERBOSE, COSTS OFF, TIMING OFF, SUMMARY OFF, BUFFERS OFF) SELECT line FROM fib LIMIT 1 OFFSET 3;
                          QUERY PLAN                          
--------------------------------------------------------------
 Limit (actual rows=1 loops=1)
   Output: line
   ->  Foreign Scan on public.fib (actual rows=4 loops=1)
         Output: line
         Program: 
 >++++++++++>+>+[
     [+++++[>++++++++<-]>.<++++++[>--------<-]+<<<]>.>>[
         [-]<[>+<-]>>[<<+>+>-]<[>+<-[>+<-[>+<-[>+<-[>+<-[>+<-
             [>+<-[>+<-[>+<-[>[-]>+>+<<<-[>+<-]]]]]]]]]]]+>>>
     ]<<<
 ]
 
         Steps: 804
(13 rows)

SELECT line FROM fib LIMIT 1 OFFSET 3;
 line 
------
 2
(1 row)

-- The first number with at least 200 digits.
EXPLAIN (ANALYZE, VERBOSE, COSTS OFF, TIMING OFF, SUMMARY OFF, BUFFERS OFF) SELECT line FROM fib WHERE length(line) >= 200 LIMIT 1;
                          QUERY PLAN                          
--------------------------------------------------------------
 Limit (actual rows=1 loops=1)
   Output: line
   ->  Foreign Scan on public.fib (actual rows=1 loops=1)
         Output: line
         Filter: (length(fib.line) >= 200)
