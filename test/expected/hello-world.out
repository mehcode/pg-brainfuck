CREATE FUNCTION bf_hello_world()
RETURNS text
AS $$
BEGIN
    ++++++++[>++++[>++>+++>+++>+<<<<-]>+>+>->>+[<]<-]>>.>---.+++++++..+++.>>.<-.<.+++.------.--------.>>+.>++.
END;
$$ LANGUAGE plbrainfuck;
SELECT bf_hello_world();
 bf_hello_world 
----------------
 Hello World!  +
 
